@using HealthInsuranceClaims.Application.ViewModels.Claims
@model ClaimDetailsViewModel
@{
    ViewData["Title"] = $"Officer Review - {Model.ClaimReferenceNumber}";
    Layout = "_Layout";
    var decisionModel = ViewBag.DecisionModel as OfficerDecisionViewModel ?? new OfficerDecisionViewModel { ClaimId = Model.ClaimId };
    bool canDecide = Model.ClaimStatus == ClaimStatus.UnderReview;
}

<div class="mb-4">
    <a asp-action="PendingClaims" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Review Queue
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-clipboard2-pulse text-primary me-2"></i>Officer Claim Review: @Model.ClaimReferenceNumber
            </h3>
            <p class="text-muted mb-0">Customer: <strong>@Model.CustomerName</strong> (@Model.CustomerEmail) | Patient: <strong>@Model.PatientName</strong></p>
        </div>
        <div class="mt-2 mt-md-0 d-flex align-items-center gap-2">
            <partial name="_StatusBadge" model="Model.ClaimStatus" />
            @if (canDecide)
            {
                <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#requestInfoModal">
                    <i class="bi bi-question-circle me-1"></i> Request More Info
                </button>
                <button type="button" class="btn btn-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#decisionModal">
                    <i class="bi bi-check2-square me-1"></i> Final Decision
                </button>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Indicative Verification Comparison Banner -->
@if (Model.LatestVerificationRun != null)
{
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-cpu text-primary me-2"></i>Automatic Policy Verification (Advisory Output)
                </h5>
                <span class="badge @(Model.LatestVerificationRun.HasExceptions ? "bg-warning text-dark" : "bg-success") px-3 py-2">
                    @(Model.LatestVerificationRun.HasExceptions ? "Manual Review Required" : "Policy Validated")
                </span>
            </div>

            <div class="row g-3 text-center">
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded border">
                        <small class="text-muted d-block fw-semibold">Total Claimed</small>
                        <h4 class="fw-bold text-dark mb-0">₹@Model.LatestVerificationRun.TotalClaimed.ToString("N2")</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded border border-success">
                        <small class="text-success d-block fw-semibold">Calculated Eligible</small>
                        <h4 class="fw-bold text-success mb-0">₹@Model.LatestVerificationRun.TotalEligible.ToString("N2")</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded border border-danger">
                        <small class="text-danger d-block fw-semibold">Non-Eligible Deductions</small>
                        <h4 class="fw-bold text-danger mb-0">₹@Model.LatestVerificationRun.TotalNonEligible.ToString("N2")</h4>
                    </div>
                </div>
            </div>

            @if (Model.LatestVerificationRun.Exceptions.Any())
            {
                <div class="alert alert-warning border-warning mt-3 mb-0 small">
                    <h6 class="fw-bold text-dark mb-1"><i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>Policy Exceptions Requiring Officer Discretion:</h6>
                    <ul class="mb-0 ps-3">
                        @foreach (var exc in Model.LatestVerificationRun.Exceptions)
                        {
                            <li><strong>@exc.ExceptionType:</strong> @exc.Message</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}

<!-- AI Claim Intelligence & Fraud Risk Report -->
@if (Model.AiAssessment != null)
{
    <div class="card shadow-sm border-0 mb-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #edf2f7 100%);">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-robot text-primary me-2"></i>Claim Intelligence & Fraud Risk Report
                </h5>
                <small class="text-muted">Predictive Assessment powered by FastTree Gradient Boosted Machine Learning Pipeline</small>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                <span class="badge @Model.AiAssessment.RiskLevelBadgeClass px-3 py-2 fs-6 shadow-sm">
                    <i class="bi bi-shield-exclamation me-1"></i> @Model.AiAssessment.RiskLevel Risk (@Model.AiAssessment.FraudRiskScore%)
                </span>
                @if (canDecide)
                {
                    <button type="button" class="btn btn-sm btn-outline-success fw-semibold shadow-sm" onclick="adoptAiRecommendation('@Model.AiAssessment.RecommendedDecision', '@Model.AiAssessment.EstimatedAdmissibleAmount.ToString("0.00")', '@(string.Join("; ", Model.AiAssessment.RiskFactors.Concat(Model.AiAssessment.PositiveFactors)).Replace("'", "\\'"))')">
                        <i class="bi bi-magic me-1"></i> Adopt AI Recommendation
                    </button>
                }
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-3 text-center mb-3">
                <div class="col-md-3">
                    <div class="p-3 bg-white rounded border shadow-sm h-100">
                        <small class="text-muted d-block fw-semibold text-uppercase">Fraud / Anomaly Score</small>
                        <h3 class="fw-bold mb-1 @(Model.AiAssessment.FraudRiskScore >= 70 ? "text-danger" : Model.AiAssessment.FraudRiskScore >= 35 ? "text-warning" : "text-success")">
                            @Model.AiAssessment.FraudRiskScore%
                        </h3>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar @(Model.AiAssessment.FraudRiskScore >= 70 ? "bg-danger" : Model.AiAssessment.FraudRiskScore >= 35 ? "bg-warning" : "bg-success")" style="width: @Model.AiAssessment.FraudRiskScore%;"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-white rounded border shadow-sm h-100">
                        <small class="text-muted d-block fw-semibold text-uppercase">AI Recommendation</small>
                        <h4 class="fw-bold mb-1 text-primary">@Model.AiAssessment.RecommendedDecision</h4>
                        <span class="small text-muted">Confidence: <strong>@Model.AiAssessment.DecisionConfidence%</strong></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-white rounded border shadow-sm h-100 border-success">
                        <small class="text-muted d-block fw-semibold text-uppercase">Estimated Admissible</small>
                        <h3 class="fw-bold text-success mb-1">₹@Model.AiAssessment.EstimatedAdmissibleAmount.ToString("N2")</h3>
                        <span class="small text-muted">Suggested Payout</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-white rounded border shadow-sm h-100">
                        <small class="text-muted d-block fw-semibold text-uppercase">Inference Latency</small>
                        <h4 class="fw-bold text-dark mb-1">&lt; 15 ms</h4>
                        <span class="small text-success"><i class="bi bi-lightning-charge-fill"></i> Real-time FastTree</span>
                    </div>
                </div>
            </div>

            <!-- Explainable AI Factors -->
            <div class="row g-3">
                @if (Model.AiAssessment.RiskFactors.Any())
                {
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded border border-warning h-100">
                            <h6 class="fw-bold text-danger mb-2 small text-uppercase">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i> Identified Risk Indicators
                            </h6>
                            <ul class="mb-0 small ps-3 text-secondary">
                                @foreach (var factor in Model.AiAssessment.RiskFactors)
                                {
                                    <li class="mb-1">@factor</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
                @if (Model.AiAssessment.PositiveFactors.Any())
                {
                    <div class="col-md-@(Model.AiAssessment.RiskFactors.Any() ? "6" : "12")">
                        <div class="p-3 bg-white rounded border border-success h-100">
                            <h6 class="fw-bold text-success mb-2 small text-uppercase">
                                <i class="bi bi-shield-check me-1"></i> Positive Compliance Indicators
                            </h6>
                            <ul class="mb-0 small ps-3 text-secondary">
                                @foreach (var factor in Model.AiAssessment.PositiveFactors)
                                {
                                    <li class="mb-1">@factor</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Patient, Hospital, Medical Expenses Breakdown -->
    <div class="col-lg-8">
        <!-- Hospitalization Details -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-hospital me-2 text-primary"></i>Hospital & Admission Data</h6>
            </div>
            <div class="card-body p-3">
                <div class="row g-2 small">
                    <div class="col-sm-4">
                        <span class="text-muted d-block">Policy:</span>
                        <strong class="text-primary">@Model.PolicyNumber</strong> (@Model.PolicyName)
                    </div>
                    <div class="col-sm-4">
                        <span class="text-muted d-block">Treating Hospital:</span>
                        <strong class="text-dark">@Model.HospitalName</strong>
                    </div>
                    <div class="col-sm-4">
                        <span class="text-muted d-block">Settlement Mode:</span>
                        <span class="badge bg-light text-dark border">@Model.ClaimType</span>
                    </div>
                    <div class="col-sm-4 mt-2">
                        <span class="text-muted d-block">Admission Date:</span>
                        <span class="fw-semibold">@Model.AdmissionDate.ToString("dd-MMM-yyyy")</span>
                    </div>
                    <div class="col-sm-4 mt-2">
                        <span class="text-muted d-block">Discharge Date:</span>
                        <span class="fw-semibold">@Model.DischargeDate.ToString("dd-MMM-yyyy")</span>
                    </div>
                    <div class="col-sm-4 mt-2">
                        <span class="text-muted d-block">Submission Date:</span>
                        <span class="fw-semibold">@(Model.SubmittedDate.HasValue ? Model.SubmittedDate.Value.ToString("dd-MMM-yyyy") : "-")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ClaimDescription))
                    {
                        <div class="col-12 mt-2">
                            <span class="text-muted d-block">Diagnosis Description:</span>
                            <div class="p-2 bg-light rounded text-secondary">@Model.ClaimDescription</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Expense Verification Details Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calculator me-2 text-primary"></i>Medical Expense Line Item Verification</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th>Description</th>
                                <th class="text-end">Claimed</th>
                                <th class="text-end">Policy Limit</th>
                                <th class="text-end">Eligible</th>
                                <th class="text-end">Deduction</th>
                                <th>Reason / Explanation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LatestVerificationRun != null && Model.LatestVerificationRun.Results.Any())
                            {
                                @foreach (var res in Model.LatestVerificationRun.Results)
                                {
                                    <tr>
                                        <td class="fw-bold">@res.ExpenseCategory</td>
                                        <td class="text-muted">@(res.Expense?.ExpenseDescription ?? "-")</td>
                                        <td class="text-end fw-semibold">₹@res.ClaimedAmount.ToString("N2")</td>
                                        <td class="text-end text-muted">
                                            @(res.AppliedLimit.HasValue ? $"₹{res.AppliedLimit.Value:N2}" : "None")
                                        </td>
                                        <td class="text-end fw-bold text-success">₹@res.EligibleAmount.ToString("N2")</td>
                                        <td class="text-end @(res.NonEligibleAmount > 0 ? "text-danger fw-bold" : "text-muted")">
                                            ₹@res.NonEligibleAmount.ToString("N2")
                                        </td>
                                        <td class="text-secondary small">
                                            @if (res.IsExcluded)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-1">Excluded</span>
                                            }
                                            @res.Reason
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                @foreach (var exp in Model.Expenses)
                                {
                                    <tr>
                                        <td class="fw-bold">@exp.ExpenseCategory</td>
                                        <td class="text-muted">@exp.ExpenseDescription</td>
                                        <td class="text-end fw-semibold">₹@exp.ClaimedAmount.ToString("N2")</td>
                                        <td colspan="4" class="text-muted">Awaiting verification run</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <th colspan="2">Aggregate Totals:</th>
                                <th class="text-end text-dark">₹@Model.TotalClaimedAmount.ToString("N2")</th>
                                <th></th>
                                <th class="text-end text-success">
                                    @(Model.LatestVerificationRun != null ? $"₹{Model.LatestVerificationRun.TotalEligible:N2}" : "-")
                                </th>
                                <th class="text-end text-danger">
                                    @(Model.LatestVerificationRun != null ? $"₹{Model.LatestVerificationRun.TotalNonEligible:N2}" : "-")
                                </th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Existing Decision if recorded -->
        @if (Model.Decision != null)
        {
            <div class="card shadow-sm border-0 border-start border-4 @(Model.Decision.Decision == DecisionType.Approved ? "border-success" : Model.Decision.Decision == DecisionType.Rejected ? "border-danger" : "border-warning") mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="bi bi-shield-check text-primary me-2"></i>Recorded Decision: @Model.Decision.Decision
                    </h5>
                    <div class="row g-2 mb-3 bg-light p-3 rounded">
                        <div class="col-sm-4">
                            <span class="text-muted small d-block">Approved Amount:</span>
                            <h4 class="fw-bold text-success mb-0">₹@Model.Decision.ApprovedAmount.ToString("N2")</h4>
                        </div>
                        <div class="col-sm-4">
                            <span class="text-muted small d-block">Decision Date:</span>
                            <span class="fw-semibold">@Model.Decision.DecisionDate.ToString("dd-MMM-yyyy hh:mm tt")</span>
                        </div>
                        <div class="col-sm-4">
                            <span class="text-muted small d-block">Adjudicating Officer:</span>
                            <span class="fw-semibold">@(Model.Decision.Officer?.FullName ?? "Officer")</span>
                        </div>
                    </div>
                    <span class="text-muted small d-block fw-bold">Mandatory Justification / Decision Notes:</span>
                    <p class="small text-dark bg-white border p-3 rounded mb-0">@Model.Decision.DecisionReason</p>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Supporting Documents & Status Audit Trail -->
    <div class="col-lg-4">
        <!-- Patient Prior Claims & Policy Balance Utilization -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Patient Prior Claims & Policy
                </h6>
                <span class="badge bg-secondary">@Model.PatientPreviousClaims.Count Past Claim(s)</span>
            </div>
            <div class="card-body p-3">
                <div class="bg-light p-3 rounded mb-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Policy Sum Insured:</span>
                        <strong class="text-dark">₹@((Model.OverallCoverageLimit ?? 0m).ToString("N2"))</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Past Approved Claims:</span>
                        <strong class="text-danger">-₹@Model.TotalPreviousApprovedAmount.ToString("N2")</strong>
                    </div>
                    <hr class="my-1">
                    <div class="d-flex justify-content-between small">
                        <span class="fw-bold text-dark">Remaining Balance:</span>
                        <strong class="text-success fw-bold">₹@Model.RemainingCoverageLimit.ToString("N2")</strong>
                    </div>
                </div>

                @if (Model.PatientPreviousClaims.Any())
                {
                    <h6 class="small fw-bold text-muted text-uppercase mb-2">Previous Claim Decisions:</h6>
                    <div class="list-group list-group-flush small">
                        @foreach (var prev in Model.PatientPreviousClaims)
                        {
                            <div class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-primary">@prev.ClaimReferenceNumber</span>
                                    <partial name="_StatusBadge" model="prev.ClaimStatus" />
                                </div>
                                <div class="d-flex justify-content-between small text-muted mt-1">
                                    <span>Claimed: ₹@prev.TotalClaimedAmount.ToString("N2")</span>
                                    @if (prev.FinalApprovedAmount.HasValue && prev.FinalApprovedAmount.Value > 0)
                                    {
                                        <span class="text-success fw-bold">Settled: ₹@prev.FinalApprovedAmount.Value.ToString("N2")</span>
                                    }
                                    else if (prev.ClaimStatus == ClaimStatus.Rejected)
                                    {
                                        <span class="text-danger fw-bold">Rejected (₹0.00)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">In Progress</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(prev.DecisionReason))
                                {
                                    <div class="small text-secondary fst-italic mt-1" style="font-size: 0.75rem;">
                                        <i class="bi bi-chat-left-quote me-1"></i>@prev.DecisionReason
                                    </div>
                                }
                                <div class="text-muted small mt-1" style="font-size: 0.7rem;">
                                    Hospital: @prev.HospitalName | Date: @prev.CreatedDate.ToString("dd-MMM-yyyy")
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-2 text-muted small">
                        <i class="bi bi-shield-check text-success d-block fs-4 mb-1"></i>
                        <span>No previous claims found for this patient under this policy.</span>
                    </div>
                }
            </div>
        </div>

        <!-- Supporting Documents List -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-paperclip me-2 text-primary"></i>Uploaded Medical Documents</h6>
            </div>
            <div class="card-body p-3">
                @if (Model.Documents.Any())
                {
                    <div class="list-group list-group-flush small">
                        @foreach (var doc in Model.Documents)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <div>
                                    <i class="bi bi-file-earmark-medical text-danger fs-5 me-2"></i>
                                    <strong>@doc.OriginalFileName</strong>
                                    <span class="badge bg-light text-dark border ms-1">@doc.DocumentType</span>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        Uploaded: @doc.UploadedDate.ToString("dd-MMM-yyyy") | @(doc.FileSize / 1024) KB
                                    </div>
                                </div>
                                <a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.DocumentId" class="btn btn-sm btn-outline-primary" target="_blank" title="View / Download Document">
                                    <i class="bi bi-download"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center mb-0">No documents uploaded by customer.</p>
                }
            </div>
        </div>

        <!-- Audit History Timeline -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Claim History</h6>
            </div>
            <div class="card-body p-3">
                <ul class="timeline mb-0">
                    @foreach (var history in Model.StatusHistories)
                    {
                        <li class="timeline-item">
                            <span class="timeline-badge @(history.NewStatus == ClaimStatus.Approved ? "success" : history.NewStatus == ClaimStatus.Rejected ? "danger" : "active")">
                                <i class="bi bi-check2"></i>
                            </span>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark small">@history.NewStatus</strong>
                                    <small class="text-muted" style="font-size: 0.75rem;">@history.ChangedDate.ToString("dd-MMM hh:mm tt")</small>
                                </div>
                                <p class="small text-secondary mb-1">@history.Comment</p>
                                <small class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-person me-1"></i>@history.ChangedByName</small>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Request Additional Information -->
<div class="modal fade" id="requestInfoModal" tabindex="-1" aria-labelledby="requestInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="requestInfoModalLabel"><i class="bi bi-question-circle me-1"></i> Request Information from Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RequestInformation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClaimId" value="@Model.ClaimId" />

                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        The claim will be placed in <strong>InformationRequested</strong> status, and the customer will receive an alert to upload additional documents or provide clarification.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Specify Required Information / Records <span class="text-danger">*</span></label>
                        <textarea name="Comment" rows="4" class="form-control" placeholder="e.g. Please provide itemized pharmacy bills and the surgeon's operative report..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-semibold">Send Request to Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Final Decision -->
<div class="modal fade" id="decisionModal" tabindex="-1" aria-labelledby="decisionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-navy text-white" style="background-color: #1a2e4c;">
                <h5 class="modal-title" id="decisionModalLabel"><i class="bi bi-check2-square me-1"></i> Render Final Claim Decision</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RecordDecision" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClaimId" value="@Model.ClaimId" />

                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Verification Indicative Eligible Amount: <strong>₹@(Model.LatestVerificationRun?.TotalEligible.ToString("N2") ?? "0.00")</strong>
                        (Total Claimed: ₹@Model.TotalClaimedAmount.ToString("N2"))
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Decision <span class="text-danger">*</span></label>
                            <select name="Decision" id="decisionSelect" class="form-select" onchange="onDecisionChanged(this.value)" required>
                                <option value="Approved">Approved</option>
                                <option value="PartiallyApproved">Partially Approved</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Final Approved Amount (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" name="ApprovedAmount" id="approvedAmountInput" class="form-control" value="@(Model.LatestVerificationRun?.TotalEligible ?? Model.TotalClaimedAmount)" required />
                            <small class="text-muted">Stored independently from system indicative amount.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Decision Reason / Justification <span class="text-danger" id="reasonRequiredAsterisk">*</span></label>
                            <textarea name="DecisionReason" id="decisionReasonInput" rows="4" class="form-control" placeholder="Provide justification for approval, deductions, or grounds for rejection..." required></textarea>
                            <small class="text-muted">Mandatory for Partial Approval and Rejection per project specifications.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Confirm & Record Decision</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function adoptAiRecommendation(decision, amount, reason) {
            const decSelect = document.getElementById('decisionSelect');
            const amtInput = document.getElementById('approvedAmountInput');
            const reasonInput = document.getElementById('decisionReasonInput');

            if (decSelect) decSelect.value = decision;
            onDecisionChanged(decision);
            if (amtInput) amtInput.value = amount;
            if (reasonInput) reasonInput.value = "AI Recommended (" + decision + "): " + reason;

            const modalEl = document.getElementById('decisionModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }
            const amtInput = document.getElementById('approvedAmountInput');
            const reasonAsterisk = document.getElementById('reasonRequiredAsterisk');
            const reasonInput = document.getElementById('decisionReasonInput');

            if (val === 'Rejected') {
                amtInput.value = '0.00';
                amtInput.readOnly = true;
                reasonInput.required = true;
                reasonAsterisk.style.display = 'inline';
            } else if (val === 'PartiallyApproved') {
                amtInput.readOnly = false;
                reasonInput.required = true;
                reasonAsterisk.style.display = 'inline';
            } else {
                amtInput.readOnly = false;
                amtInput.value = '@(Model.LatestVerificationRun?.TotalEligible ?? Model.TotalClaimedAmount)';
                reasonInput.required = false;
                reasonAsterisk.style.display = 'none';
            }
        }
    </script>
}
