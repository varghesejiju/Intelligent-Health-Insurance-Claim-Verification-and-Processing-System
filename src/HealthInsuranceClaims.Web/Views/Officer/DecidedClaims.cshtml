@using HealthInsuranceClaims.Application.ViewModels.Claims
@using HealthInsuranceClaims.Domain.Enums
@model List<ClaimListViewModel>
@{
    ViewData["Title"] = "Previous Claims & Adjudication History";
    Layout = "_Layout";
    var selectedDecision = ViewBag.SelectedDecision as DecisionType?;
    var search = ViewBag.Search as string;
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-clock-history text-success me-2"></i>Previous Claims & Adjudication History
        </h3>
        <p class="text-muted mb-0">Audit and inspect all settled claims (Approved, Partially Approved, and Rejected) with reason breakdown</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="PendingClaims" class="btn btn-warning fw-semibold px-3 py-2 shadow-sm">
            <i class="bi bi-hourglass-split me-1"></i> New Requests Queue
        </a>
    </div>
</div>

<!-- Filter and Search Bar -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search Claim #, Patient, Customer, Hospital..." value="@search" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="decision" class="form-select form-select-sm">
                    <option value="">-- All Decisions (Approved, Partial, Rejected) --</option>
                    @foreach (var dec in Enum.GetValues<DecisionType>())
                    {
                        if (selectedDecision.HasValue && selectedDecision.Value == dec)
                        {
                            <option value="@dec" selected>@dec</option>
                        }
                        else
                        {
                            <option value="@dec">@dec</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="DecidedClaims" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Quick Decision Filter Pills -->
<div class="d-flex gap-2 mb-3">
    <a asp-action="DecidedClaims" asp-route-search="@search" class="btn btn-sm @(selectedDecision == null ? "btn-dark fw-bold" : "btn-outline-secondary")">
        All Decided (@Model.Count)
    </a>
    <a asp-action="DecidedClaims" asp-route-decision="@DecisionType.Approved" asp-route-search="@search" class="btn btn-sm @(selectedDecision == DecisionType.Approved ? "btn-success fw-bold" : "btn-outline-success")">
        <i class="bi bi-check-circle me-1"></i> Fully Approved
    </a>
    <a asp-action="DecidedClaims" asp-route-decision="@DecisionType.PartiallyApproved" asp-route-search="@search" class="btn btn-sm @(selectedDecision == DecisionType.PartiallyApproved ? "btn-warning fw-bold" : "btn-outline-warning")">
        <i class="bi bi-pie-chart me-1"></i> Partially Approved
    </a>
    <a asp-action="DecidedClaims" asp-route-decision="@DecisionType.Rejected" asp-route-search="@search" class="btn btn-sm @(selectedDecision == DecisionType.Rejected ? "btn-danger fw-bold" : "btn-outline-danger")">
        <i class="bi bi-x-circle me-1"></i> Rejected
    </a>
</div>

<!-- Decided Claims Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Claim Ref #</th>
                            <th>Customer & Patient</th>
                            <th>Policy Number</th>
                            <th>Hospital</th>
                            <th>Claimed Amount</th>
                            <th>Settlement / Approved</th>
                            <th>Decision Status</th>
                            <th>Officer Justification / Grounds</th>
                            <th>Decision Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-primary">@claim.ClaimReferenceNumber</span>
                                    <div class="small text-muted">@claim.ClaimType</div>
                                </td>
                                <td>
                                    <strong class="text-dark">@claim.PatientName</strong>
                                    <div class="small text-muted">Customer: @claim.CustomerName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@claim.PolicyNumber</span>
                                </td>
                                <td class="small text-muted">@claim.HospitalName</td>
                                <td class="fw-semibold">₹@claim.TotalClaimedAmount.ToString("N2")</td>
                                <td>
                                    @if (claim.FinalApprovedAmount.HasValue && claim.FinalApprovedAmount.Value > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success fs-6 fw-bold border border-success-subtle">
                                            ₹@claim.FinalApprovedAmount.Value.ToString("N2")
                                        </span>
                                        @if (claim.DeductionAmount.HasValue && claim.DeductionAmount.Value > 0)
                                        {
                                            <div class="small text-danger mt-1">
                                                -₹@claim.DeductionAmount.Value.ToString("N2") deduction
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger fs-6 fw-bold border border-danger-subtle">
                                            ₹0.00
                                        </span>
                                    }
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model="claim.ClaimStatus" />
                                </td>
                                <td class="small text-muted" style="max-width: 300px;">
                                    @if (!string.IsNullOrEmpty(claim.DecisionReason))
                                    {
                                        <div class="text-truncate" title="@claim.DecisionReason">
                                            @claim.DecisionReason
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="fst-italic text-muted">-</span>
                                    }
                                    @if (!string.IsNullOrEmpty(claim.OfficerName))
                                    {
                                        <div class="small text-secondary mt-1">
                                            <i class="bi bi-person-check me-1"></i>@claim.OfficerName
                                        </div>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(claim.DecisionDate.HasValue ? claim.DecisionDate.Value.ToString("dd-MMM-yyyy") : claim.CreatedDate.ToString("dd-MMM-yyyy"))
                                </td>
                                <td class="text-end">
                                    <a asp-action="Review" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> View Record
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-folder2-open fs-1 d-block mb-3 text-secondary"></i>
                <h5>No Matching Decided Claims</h5>
                <p class="small mb-0">No past claims match the selected filter criteria.</p>
            </div>
        }
    </div>
</div>
