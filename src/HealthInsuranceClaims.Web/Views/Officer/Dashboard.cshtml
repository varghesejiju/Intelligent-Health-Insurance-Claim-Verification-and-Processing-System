@using HealthInsuranceClaims.Application.ViewModels.Dashboard
@model OfficerDashboardViewModel
@{
    ViewData["Title"] = "Insurance Officer Dashboard";
    Layout = "_Layout";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-shield-shaded text-success me-2"></i>Officer Adjudication Dashboard
        </h3>
        <p class="text-muted mb-0">Claim Queue Inspection, Policy Verification & Adjudication Controls</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="PendingClaims" class="btn btn-success fw-semibold px-3 py-2 shadow-sm">
            <i class="bi bi-hourglass-split me-1"></i> Open Review Queue (@Model.PendingReviews)
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card stat-warning p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Pending Reviews</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.PendingReviews</h3>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-hourglass-bottom fs-4"></i>
                </div>
            </div>
            <a asp-action="PendingClaims" class="stretched-link text-decoration-none small text-warning mt-2 d-inline-block">Open review queue &rarr;</a>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card stat-info p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Info Requested</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.InfoRequestedClaims</h3>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="bi bi-question-circle fs-4"></i>
                </div>
            </div>
            <span class="text-muted small mt-2 d-inline-block">Awaiting customer response</span>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card stat-success p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Approved Claims</span>
                    <h3 class="fw-bold mb-0 text-dark">@(Model.ApprovedClaims + Model.PartiallyApprovedClaims)</h3>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>
            </div>
            <span class="text-muted small mt-2 d-inline-block">₹@Model.TotalApprovedAmount.ToString("N2") settled</span>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card stat-danger p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Rejected Claims</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.RejectedClaims</h3>
                </div>
                <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                    <i class="bi bi-x-circle-fill fs-4"></i>
                </div>
            </div>
            <span class="text-muted small mt-2 d-inline-block">With documented grounds</span>
        </div>
    </div>
</div>

<!-- Claims Navigation Tabs: New Requests vs Previous Claims -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <ul class="nav nav-pills card-header-pills" id="officerClaimsTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold px-3 py-2" id="new-requests-tab" data-bs-toggle="pill" data-bs-target="#new-requests" type="button" role="tab">
                    <i class="bi bi-inbox-fill text-warning me-1"></i> New Requests Awaiting Action 
                    <span class="badge bg-warning text-dark ms-1">@Model.PendingReviewQueue.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold px-3 py-2" id="previous-claims-tab" data-bs-toggle="pill" data-bs-target="#previous-claims" type="button" role="tab">
                    <i class="bi bi-check2-all text-success me-1"></i> Previous Claims & Adjudication History
                    <span class="badge bg-success ms-1">@Model.DecidedClaims.Count</span>
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="officerClaimsTabContent">
            <!-- Tab 1: New Requests Queue -->
            <div class="tab-pane fade show active" id="new-requests" role="tabpanel">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <span class="small text-muted fw-semibold">Claims submitted or resubmitted awaiting verification and officer decision</span>
                    <a asp-action="PendingClaims" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-arrows-fullscreen me-1"></i> Full Review Queue
                    </a>
                </div>
                @if (Model.PendingReviewQueue.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Claim Ref #</th>
                                    <th>Customer Name</th>
                                    <th>Patient</th>
                                    <th>Policy Number</th>
                                    <th>Hospital</th>
                                    <th>Total Claimed</th>
                                    <th>Auto-Eligible</th>
                                    <th>Status</th>
                                    <th>Exceptions</th>
                                    <th>Submission Date</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.PendingReviewQueue)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@claim.ClaimReferenceNumber</td>
                                        <td>@claim.CustomerName</td>
                                        <td>@claim.PatientName</td>
                                        <td><span class="badge bg-light text-dark border">@claim.PolicyNumber</span></td>
                                        <td class="small text-muted">@claim.HospitalName</td>
                                        <td class="fw-semibold">₹@claim.TotalClaimedAmount.ToString("N2")</td>
                                        <td>
                                            @if (claim.IndicativeEligibleAmount.HasValue)
                                            {
                                                <span class="text-success fw-bold">₹@claim.IndicativeEligibleAmount.Value.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td>
                                            <partial name="_StatusBadge" model="claim.ClaimStatus" />
                                        </td>
                                        <td>
                                            @if (claim.HasExceptions)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Review Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="bi bi-check-lg me-1"></i> No Exceptions
                                                </span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @(claim.SubmittedDate.HasValue ? claim.SubmittedDate.Value.ToString("dd-MMM-yyyy") : claim.CreatedDate.ToString("dd-MMM-yyyy"))
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Review" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-primary">
                                                <i class="bi bi-search me-1"></i> Review & Decide
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-check2-all fs-1 d-block mb-3 text-success"></i>
                        <h5>Review Queue is Clear</h5>
                        <p class="small mb-0">No new claims currently pending review in your adjudication inbox.</p>
                    </div>
                }
            </div>

            <!-- Tab 2: Previous Claims & Decisions -->
            <div class="tab-pane fade" id="previous-claims" role="tabpanel">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <span class="small text-muted fw-semibold">Previously adjudicated claims (Approved, Partially Approved, and Rejected)</span>
                    <a asp-action="DecidedClaims" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-folder2-open me-1"></i> View All Adjudications
                    </a>
                </div>
                @if (Model.DecidedClaims.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Claim Ref #</th>
                                    <th>Customer / Patient</th>
                                    <th>Hospital</th>
                                    <th>Total Claimed</th>
                                    <th>Approved Amount</th>
                                    <th>Decision Status</th>
                                    <th>Officer Justification / Reason</th>
                                    <th>Decision Date</th>
                                    <th class="text-end">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.DecidedClaims)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-primary">@claim.ClaimReferenceNumber</span>
                                            <div class="small text-muted">Policy: @claim.PolicyNumber</div>
                                        </td>
                                        <td>
                                            <strong>@claim.PatientName</strong>
                                            <div class="small text-muted">Customer: @claim.CustomerName</div>
                                        </td>
                                        <td class="small text-muted">@claim.HospitalName</td>
                                        <td class="fw-semibold">₹@claim.TotalClaimedAmount.ToString("N2")</td>
                                        <td>
                                            @if (claim.FinalApprovedAmount.HasValue && claim.FinalApprovedAmount.Value > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success fs-6 fw-bold border border-success-subtle">
                                                    ₹@claim.FinalApprovedAmount.Value.ToString("N2")
                                                </span>
                                                @if (claim.DeductionAmount.HasValue && claim.DeductionAmount.Value > 0)
                                                {
                                                    <div class="small text-danger mt-1">
                                                        -₹@claim.DeductionAmount.Value.ToString("N2") deduction
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    ₹0.00
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <partial name="_StatusBadge" model="claim.ClaimStatus" />
                                        </td>
                                        <td class="small text-muted" style="max-width: 280px;">
                                            @if (!string.IsNullOrEmpty(claim.DecisionReason))
                                            {
                                                <span title="@claim.DecisionReason">
                                                    @(claim.DecisionReason.Length > 80 ? claim.DecisionReason.Substring(0, 80) + "..." : claim.DecisionReason)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">No reason recorded</span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @(claim.DecisionDate.HasValue ? claim.DecisionDate.Value.ToString("dd-MMM-yyyy") : claim.CreatedDate.ToString("dd-MMM-yyyy"))
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Review" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye me-1"></i> Inspect
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                        <h5>No Previous Decisions Found</h5>
                        <p class="small mb-0">No past claims have been adjudicated yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
