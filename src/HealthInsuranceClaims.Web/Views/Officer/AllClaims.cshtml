@using HealthInsuranceClaims.Application.ViewModels.Claims
@model List<ClaimListViewModel>
@{
    ViewData["Title"] = "All Insurance Claims";
    Layout = "_Layout";
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">
        <i class="bi bi-list-check text-primary me-2"></i>All Insurance Claims
    </h3>
    <p class="text-muted mb-0">Search, filter, and review claims across all system statuses</p>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Claim #, Patient, Customer" value="@ViewBag.Search" />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- All Statuses --</option>
                    @foreach (var s in Enum.GetValues<HealthInsuranceClaims.Domain.Enums.ClaimStatus>())
                    {
                        if (ViewBag.Status != null && (HealthInsuranceClaims.Domain.Enums.ClaimStatus)ViewBag.Status == s)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" placeholder="From Date" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" placeholder="To Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="AllClaims" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Claim Ref #</th>
                            <th>Customer</th>
                            <th>Patient</th>
                            <th>Policy Number</th>
                            <th>Hospital</th>
                            <th>Claimed Amount</th>
                            <th>Approved Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@claim.ClaimReferenceNumber</td>
                                <td>@claim.CustomerName</td>
                                <td class="fw-semibold">@claim.PatientName</td>
                                <td><span class="badge bg-light text-dark border">@claim.PolicyNumber</span></td>
                                <td class="small text-muted">@claim.HospitalName</td>
                                <td class="fw-semibold">₹@claim.TotalClaimedAmount.ToString("N2")</td>
                                <td>
                                    @if (claim.FinalApprovedAmount.HasValue)
                                    {
                                        <span class="badge bg-success-subtle text-success fs-6 fw-bold border border-success-subtle">
                                            ₹@claim.FinalApprovedAmount.Value.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model="claim.ClaimStatus" />
                                </td>
                                <td class="text-muted small">@claim.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Review" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> Inspect
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-search fs-1 d-block mb-3 text-secondary"></i>
                <h5>No Matching Claims Found</h5>
                <p class="small mb-0">Try adjusting your search criteria or date filters.</p>
            </div>
        }
    </div>
</div>
