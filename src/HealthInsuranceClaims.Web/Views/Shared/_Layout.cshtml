@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Intelligent Health Insurance System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-shaded fs-3 text-info me-2"></i>
                    <span>HealthClaim<span class="text-info">Pro</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Policies">
                                        <i class="bi bi-file-earmark-medical me-1"></i> Policies
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Hospitals">
                                        <i class="bi bi-hospital me-1"></i> Hospitals
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                        <i class="bi bi-people me-1"></i> Users
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Claims">
                                        <i class="bi bi-folder2-open me-1"></i> All Claims
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="AuditLogs">
                                        <i class="bi bi-journal-text me-1"></i> Audit Logs
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-warning" asp-controller="Admin" asp-action="AiRiskAnalytics">
                                        <i class="bi bi-cpu me-1"></i> AI Risk Analytics
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("InsuranceOfficer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Officer" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Officer" asp-action="PendingClaims">
                                        <i class="bi bi-inbox-fill me-1"></i> New Requests
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Officer" asp-action="DecidedClaims">
                                        <i class="bi bi-clock-history me-1"></i> Previous Claims
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Officer" asp-action="AllClaims">
                                        <i class="bi bi-list-check me-1"></i> All Claims
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("HospitalDesk"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="HospitalDesk" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Hospital Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="HospitalDesk" asp-action="CreateClaim">
                                        <i class="bi bi-file-earmark-plus me-1"></i> Submit Patient Claim
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="HospitalDesk" asp-action="Claims">
                                        <i class="bi bi-hospital me-1"></i> Hospital Claims
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Customer" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Patient Portal
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Customer" asp-action="Policies">
                                        <i class="bi bi-shield-check me-1"></i> My Insurance Policies
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Customer" asp-action="Claims">
                                        <i class="bi bi-card-checklist me-1"></i> Claim Status & Enquiry
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house me-1"></i> Home
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            var displayName = user?.FullName ?? User.Identity?.Name ?? "User";

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 me-1 text-info"></i>
                                    <span>@displayName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                                    <li>
                                        <div class="px-3 py-2 border-bottom">
                                            <small class="text-muted d-block">Signed in as:</small>
                                            <span class="fw-semibold text-dark">@User.Identity?.Name</span>
                                        </div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-primary"></i> My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key me-2 text-primary"></i> Change Password
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-info btn-sm px-3 text-dark fw-semibold" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content">
        <main role="main" class="py-3">
            <div class="container-fluid px-4">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="py-3 mt-4 text-center text-muted small">
        <div class="container-fluid px-4 d-flex justify-content-center align-items-center">
            <span>&copy; @DateTime.UtcNow.Year Intelligent Health Insurance Claim Verification and Processing System</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
