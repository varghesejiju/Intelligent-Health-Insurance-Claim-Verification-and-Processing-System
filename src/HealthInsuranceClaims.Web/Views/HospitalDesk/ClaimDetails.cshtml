@model HealthInsuranceClaims.Application.ViewModels.Claims.ClaimDetailsViewModel
@using HealthInsuranceClaims.Domain.Enums
@{
    ViewData["Title"] = $"Manage Claim {Model.ClaimReferenceNumber} - Hospital Desk";
    bool isDraft = Model.ClaimStatus == ClaimStatus.Draft;
    bool isInfoRequested = Model.ClaimStatus == ClaimStatus.InformationRequested;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Claims" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Back to Hospital Claims
        </a>
        <h2 class="h3 fw-bold mb-0 text-dark mt-1">
            Claim Ref: <span class="text-primary">@Model.ClaimReferenceNumber</span>
        </h2>
        <small class="text-muted">Hospital Billing & Medical Submission Workbench &bull; @Model.HospitalName</small>
    </div>
    <div class="d-flex align-items-center gap-2">
        @switch (Model.ClaimStatus)
        {
            case ClaimStatus.Draft:
                <span class="badge bg-secondary fs-6 px-3 py-2">Draft (Awaiting Submission)</span>
                break;
            case ClaimStatus.Submitted:
                <span class="badge bg-info text-dark fs-6 px-3 py-2">Submitted to Insurance</span>
                break;
            case ClaimStatus.UnderReview:
                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Under Officer Review</span>
                break;
            case ClaimStatus.InformationRequested:
                <span class="badge bg-danger fs-6 px-3 py-2">Query Raised (Action Required)</span>
                break;
            case ClaimStatus.Resubmitted:
                <span class="badge bg-primary fs-6 px-3 py-2">Resubmitted to Officer</span>
                break;
            case ClaimStatus.Approved:
                <span class="badge bg-success fs-6 px-3 py-2">Approved by Insurance</span>
                break;
            case ClaimStatus.PartiallyApproved:
                <span class="badge bg-success bg-opacity-75 fs-6 px-3 py-2">Partially Approved</span>
                break;
            case ClaimStatus.Rejected:
                <span class="badge bg-danger fs-6 px-3 py-2">Rejected</span>
                break;
            default:
                <span class="badge bg-light text-dark border fs-6 px-3 py-2">@Model.ClaimStatus</span>
                break;
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (isInfoRequested)
{
    <div class="card border-danger mb-4 shadow-sm">
        <div class="card-header bg-danger text-white py-2 fw-semibold">
            <i class="bi bi-bell-fill me-1"></i> Action Required: Insurance Officer Query
        </div>
        <div class="card-body">
            @{
                var queryHist = Model.StatusHistories.FirstOrDefault(h => h.NewStatus == ClaimStatus.InformationRequested);
            }
            <p class="mb-2 fw-semibold text-danger">The Insurance Review Officer has requested supplementary information or revised documentation:</p>
            <blockquote class="blockquote fs-6 bg-light p-3 rounded border-start border-danger border-4 mb-3">
                @(queryHist?.Comment ?? "Please upload additional diagnostic reports or clear itemized hospital bills.")
            </blockquote>
            <a asp-action="RespondRequest" asp-route-id="@Model.ClaimId" class="btn btn-danger fw-semibold">
                <i class="bi bi-reply-fill me-1"></i> Upload Requested Document / Respond to Query
            </a>
        </div>
    </div>
}

<!-- Patient & Policy Overview Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="bi bi-person-vcard text-primary me-2"></i>Patient & Insurance Policy Details
        </h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <span class="text-muted small d-block">Patient Name</span>
                <span class="fw-bold text-dark fs-6">@Model.PatientName</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Customer / Policyholder</span>
                <span class="fw-semibold text-dark">@Model.CustomerName</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Policy Number</span>
                <span class="fw-semibold text-primary">@Model.PolicyNumber</span>
                <small class="text-muted d-block">(@Model.PolicyName)</small>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Hospital</span>
                <span class="fw-semibold text-dark">@Model.HospitalName</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Admission Date</span>
                <span class="fw-semibold text-dark">@Model.AdmissionDate.ToString("dd-MMM-yyyy")</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Discharge Date</span>
                <span class="fw-semibold text-dark">@Model.DischargeDate.ToString("dd-MMM-yyyy")</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Claim Type</span>
                <span class="badge bg-secondary-subtle text-secondary border">@Model.ClaimType</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Total Claimed Quotation</span>
                <span class="fw-bold fs-5 text-primary">₹@Model.TotalClaimedAmount.ToString("N2")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ClaimDescription))
            {
                <div class="col-12 pt-2 border-top">
                    <span class="text-muted small d-block">Diagnosis / Medical Treatment Summary</span>
                    <p class="mb-0 text-secondary">@Model.ClaimDescription</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Section 1: Itemized Medical Expenses Quotation -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-receipt text-primary me-2"></i>Itemized Medical Expenses (Quotation)
            </h5>
            <small class="text-muted">Itemize all hospital charges against applicable policy limits</small>
        </div>
        @if (isDraft)
        {
            <button type="button" class="btn btn-sm btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                <i class="bi bi-plus-circle me-1"></i> Add Medical Expense Item
            </button>
        }
    </div>
    <div class="card-body p-0">
        @if (Model.Expenses == null || !Model.Expenses.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-card-list fs-2 d-block mb-1 text-secondary"></i>
                <p class="mb-2">No medical expenses added to this quotation yet.</p>
                @if (isDraft)
                {
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                        <i class="bi bi-plus-circle me-1"></i> Add First Expense Item
                    </button>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Expense Date</th>
                            <th class="text-end">Claimed Amount (₹)</th>
                            @if (isDraft)
                            {
                                <th class="text-end">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exp in Model.Expenses)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @exp.ExpenseCategory
                                    </span>
                                </td>
                                <td>@exp.ExpenseDescription</td>
                                <td>@exp.ExpenseDate.ToString("dd-MMM-yyyy")</td>
                                <td class="text-end fw-bold">₹@exp.ClaimedAmount.ToString("N2")</td>
                                @if (isDraft)
                                {
                                    <td class="text-end">
                                        <form asp-action="RemoveExpense" method="post" class="d-inline" onsubmit="return confirm('Remove this expense item?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="expenseId" value="@exp.ExpenseId" />
                                            <input type="hidden" name="claimId" value="@Model.ClaimId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end fw-bold">Total Claim Quotation Amount:</th>
                            <th class="text-end fw-bold text-primary fs-6">₹@Model.TotalClaimedAmount.ToString("N2")</th>
                            @if (isDraft)
                            {
                                <th></th>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

<!-- Section 2: Patient Medical Documents -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-file-earmark-arrow-up text-primary me-2"></i>Official Medical Documents & Reports
            </h5>
            <small class="text-muted">Upload patient hospital bill, discharge summary, prescriptions and diagnostic reports</small>
        </div>
    </div>
    <div class="card-body">
        @if (isDraft)
        {
            <div class="bg-light p-3 rounded-3 mb-4 border">
                <h6 class="fw-bold mb-3 text-dark">
                    <i class="bi bi-cloud-arrow-up text-primary me-1"></i> Upload Supporting Document
                </h6>
                <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="claimId" value="@Model.ClaimId" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Document Type <span class="text-danger">*</span></label>
                            <select name="documentType" class="form-select" required>
                                <option value="@DocumentType.HospitalBill">Hospital Final Bill / Invoice</option>
                                <option value="@DocumentType.DischargeSummary">Discharge Summary</option>
                                <option value="@DocumentType.MedicalPrescription">Doctor Prescription / Operative Notes</option>
                                <option value="@DocumentType.LaboratoryReport">Laboratory Investigation Report</option>
                                <option value="@DocumentType.DiagnosticReport">Diagnostic Scan / Imaging Report</option>
                                <option value="@DocumentType.OtherSupportingDocument">Other Supporting Document</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Select File (PDF, JPG, PNG - Max 10MB) <span class="text-danger">*</span></label>
                            <input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                                <i class="bi bi-upload me-1"></i> Upload Document
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        }

        @if (Model.Documents == null || !Model.Documents.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-folder-x fs-2 d-block mb-1 text-secondary"></i>
                <p class="mb-0">No documents uploaded yet. Hospital desk must upload official hospital bills and discharge summary.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Document Type</th>
                            <th>Original File Name</th>
                            <th>File Size</th>
                            <th>Uploaded On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        @doc.DocumentType
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">
                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> @doc.OriginalFileName
                                </td>
                                <td class="text-muted">@((doc.FileSize / 1024.0).ToString("N1")) KB</td>
                                <td class="text-muted">@doc.UploadedDate.ToString("dd-MMM-yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.DocumentId" class="btn btn-sm btn-outline-primary me-1" target="_blank">
                                        <i class="bi bi-download me-1"></i> Download
                                    </a>
                                    @if (isDraft)
                                    {
                                        <form asp-action="DeleteDocument" method="post" class="d-inline" onsubmit="return confirm('Delete this uploaded document?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="documentId" value="@doc.DocumentId" />
                                            <input type="hidden" name="claimId" value="@Model.ClaimId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Section 3: Verification Recommendations & Results (if submitted) -->
@if (Model.LatestVerificationRun != null)
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-cpu text-primary me-2"></i>Automated Policy Verification Breakdown
            </h5>
            <small class="text-muted">Calculated on: @Model.LatestVerificationRun.RunDate.ToString("dd-MMM-yyyy HH:mm")</small>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3 text-center">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted fw-semibold">Total Claimed</small>
                        <h4 class="mb-0 fw-bold text-dark mt-1">₹@Model.TotalClaimedAmount.ToString("N2")</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-success-subtle rounded-3">
                        <small class="text-success fw-semibold">Calculated Eligible Amount</small>
                        <h4 class="mb-0 fw-bold text-success mt-1">₹@Model.LatestVerificationRun.TotalEligible.ToString("N2")</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-danger-subtle rounded-3">
                        <small class="text-danger fw-semibold">Non-Eligible Deductions</small>
                        <h4 class="mb-0 fw-bold text-danger mt-1">₹@Model.LatestVerificationRun.TotalNonEligible.ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <!-- Itemized Verification Results -->
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th class="text-end">Claimed</th>
                            <th class="text-end">Eligible</th>
                            <th class="text-end">Deduction</th>
                            <th>Verification Findings & Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model.LatestVerificationRun.Results)
                        {
                            <tr>
                                <td class="fw-semibold">@res.ExpenseCategory</td>
                                <td class="text-end">₹@res.ClaimedAmount.ToString("N2")</td>
                                <td class="text-end text-success fw-bold">₹@res.EligibleAmount.ToString("N2")</td>
                                <td class="text-end text-danger">₹@res.NonEligibleAmount.ToString("N2")</td>
                                <td>
                                    @if (res.IsExcluded)
                                    {
                                        <span class="badge bg-danger me-1">Excluded</span>
                                    }
                                    @if (res.AppliedLimit.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark me-1">Limit Capped</span>
                                    }
                                    <span class="small text-secondary">@res.Reason</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.LatestVerificationRun.Exceptions != null && Model.LatestVerificationRun.Exceptions.Any())
            {
                <div class="alert alert-warning mb-0 mt-3">
                    <h6 class="fw-bold mb-1"><i class="bi bi-flag-fill me-1"></i> Policy Exceptions Identified:</h6>
                    <ul class="mb-0 small ps-3">
                        @foreach (var exc in Model.LatestVerificationRun.Exceptions)
                        {
                            <li><strong>@exc.ExceptionType:</strong> @exc.Message</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}

<!-- Section 4: Officer Decision (if processed) -->
@if (Model.Decision != null)
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-shield-check text-success me-2"></i>Official Insurance Officer Decision
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <span class="text-muted small d-block">Decision</span>
                    <span class="fw-bold fs-5 @(Model.Decision.Decision == DecisionType.Approved ? "text-success" : (Model.Decision.Decision == DecisionType.PartiallyApproved ? "text-warning" : "text-danger"))">
                        @Model.Decision.Decision
                    </span>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Final Approved Amount</span>
                    <span class="fw-bold fs-4 text-success">₹@Model.Decision.ApprovedAmount.ToString("N2")</span>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">Reviewed By</span>
                    <span class="fw-semibold text-dark">@(Model.Decision.Officer?.FullName ?? Model.Decision.OfficerId)</span>
                    <small class="text-muted d-block">@Model.Decision.DecisionDate.ToString("dd-MMM-yyyy HH:mm")</small>
                </div>
                <div class="col-12 pt-2 border-top">
                    <span class="text-muted small d-block">Officer Decision Remarks / Settlement Justification</span>
                    <p class="mb-0 text-dark fw-semibold">@Model.Decision.DecisionReason</p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Submission Action (if Draft) -->
@if (isDraft)
{
    <div class="card border-primary mb-4 shadow-sm bg-primary-subtle">
        <div class="card-body d-flex justify-content-between align-items-center py-3">
            <div>
                <h5 class="mb-1 fw-bold text-primary">
                    <i class="bi bi-send-check me-2"></i>Ready to Submit Claim to Insurance?
                </h5>
                <p class="text-muted mb-0 small">
                    Ensure all itemized expenses are entered and the official hospital bills and discharge summary are uploaded.
                </p>
            </div>
            <form asp-action="SubmitClaim" method="post" onsubmit="return confirm('Are you sure you want to submit this claim for verification and officer review? Financial quotation amounts cannot be modified after submission.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ClaimId" />
                <button type="submit" class="btn btn-primary btn-lg px-4 fw-semibold shadow">
                    <i class="bi bi-arrow-up-right-circle me-1"></i> Submit Claim to Insurance
                </button>
            </form>
        </div>
    </div>
}

<!-- Add Expense Modal (for Draft) -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddExpense" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClaimId" value="@Model.ClaimId" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addExpenseModalLabel">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Add Medical Expense Item
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expense Category <span class="text-danger">*</span></label>
                        <select name="ExpenseCategory" class="form-select" required>
                            <option value="@ExpenseCategory.HospitalRoomCharges">Hospital Room Charges</option>
                            <option value="@ExpenseCategory.SurgeryCharges">Surgery / Operation Theatre Charges</option>
                            <option value="@ExpenseCategory.DoctorConsultation">Doctor / Specialist Consultation</option>
                            <option value="@ExpenseCategory.MedicineExpenses">Medicine & Pharmacy Expenses</option>
                            <option value="@ExpenseCategory.LaboratoryTests">Laboratory Tests / Pathology</option>
                            <option value="@ExpenseCategory.DiagnosticScans">Diagnostic Scans (MRI/CT/X-Ray)</option>
                            <option value="@ExpenseCategory.OtherMedicalExpenses">Other Medical Expenses</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item Description <span class="text-danger">*</span></label>
                        <input type="text" name="ExpenseDescription" class="form-control" placeholder="e.g. Standard AC Room (3 days) or Laparoscopic Appendectomy" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Expense Date <span class="text-danger">*</span></label>
                            <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Claimed Amount (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="1" name="ClaimedAmount" class="form-control" placeholder="0.00" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Add to Quotation</button>
                </div>
            </form>
        </div>
    </div>
</div>
