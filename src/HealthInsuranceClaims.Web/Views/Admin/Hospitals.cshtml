@using HealthInsuranceClaims.Application.ViewModels.Hospitals
@model List<HospitalViewModel>
@{
    ViewData["Title"] = "Manage Hospitals";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-hospital text-primary me-2"></i>Network Hospitals Directory</h3>
        <p class="text-muted mb-0">Manage accredited network hospitals authorized for claim treatments</p>
    </div>
    <a asp-action="CreateHospital" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-circle me-1"></i> Add Hospital
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hospital Name</th>
                        <th>Address / Location</th>
                        <th>Contact Number</th>
                        <th>Email</th>
                        <th>Claims Processed</th>
                        <th>Network Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-building me-1 text-primary"></i>@h.HospitalName
                            </td>
                            <td class="small text-muted">@h.Address</td>
                            <td class="small">@h.ContactNumber</td>
                            <td class="small text-muted">@h.Email</td>
                            <td><span class="badge bg-light text-dark border">@h.TotalClaimsTreated claims</span></td>
                            <td>
                                <span class="badge @(h.IsActive ? "bg-success" : "bg-danger")">
                                    @(h.IsActive ? "Active Network" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="EditHospital" asp-route-id="@h.HospitalId" class="btn btn-sm btn-outline-secondary" title="Edit Hospital">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleHospitalStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@h.HospitalId" />
                                        <button type="submit" class="btn btn-sm @(h.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(h.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(h.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
