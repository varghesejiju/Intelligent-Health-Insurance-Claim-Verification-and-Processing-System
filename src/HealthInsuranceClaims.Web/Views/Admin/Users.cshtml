@model List<(HealthInsuranceClaims.Domain.Entities.ApplicationUser User, string Role)>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-people text-primary me-2"></i>User Accounts Administration</h3>
        <p class="text-muted mb-0">View registered customers and insurance officers; toggle account access</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email / Username</th>
                        <th>Role</th>
                        <th>Phone</th>
                        <th>Registration Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.User.FullName</td>
                            <td>@item.User.Email</td>
                            <td>
                                @if (item.Role == "Administrator")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Administrator</span>
                                }
                                else if (item.Role == "InsuranceOfficer")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Insurance Officer</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Customer</span>
                                }
                            </td>
                            <td class="small text-muted">@(item.User.PhoneNumber ?? "-")</td>
                            <td class="small text-muted">@item.User.CreatedDate.ToString("dd-MMM-yyyy")</td>
                            <td>
                                <span class="badge @(item.User.AccountStatus == "Active" ? "bg-success" : "bg-danger")">
                                    @item.User.AccountStatus
                                </span>
                            </td>
                            <td class="text-end">
                                @if (item.Role != "Administrator")
                                {
                                    <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.User.Id" />
                                        <button type="submit" class="btn btn-sm @(item.User.AccountStatus == "Active" ? "btn-outline-danger" : "btn-outline-success")">
                                            @(item.User.AccountStatus == "Active" ? "Suspend Account" : "Reactivate")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
