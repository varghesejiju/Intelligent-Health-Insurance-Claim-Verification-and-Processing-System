@using HealthInsuranceClaims.Application.ViewModels.Claims
@model ClaimDetailsViewModel
@{
    ViewData["Title"] = $"Track Claim - {Model.ClaimReferenceNumber}";
    Layout = "_Layout";
}

<div class="mb-4">
    <a asp-action="Claims" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to My Claims
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-crosshair me-2 text-primary"></i>Claim Tracking: @Model.ClaimReferenceNumber
            </h3>
            <p class="text-muted mb-0">Patient: <strong>@Model.PatientName</strong> | Policy: <strong>@Model.PolicyNumber</strong> (@Model.PolicyName)</p>
        </div>
        <div class="mt-2 mt-md-0">
            <partial name="_StatusBadge" model="Model.ClaimStatus" />
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Important Action Alert if Information Requested -->
@if (Model.ClaimStatus == ClaimStatus.InformationRequested)
{
    <div class="alert alert-warning border-warning shadow-sm mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h5 class="alert-heading fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Action Required: Additional Information Requested</h5>
                <p class="mb-0 small">The reviewing Insurance Officer has requested additional clarification or supporting medical documents.</p>
            </div>
            <a asp-action="RespondRequest" asp-route-id="@Model.ClaimId" class="btn btn-warning fw-semibold shadow-sm">
                <i class="bi bi-reply-fill me-1"></i> Respond to Officer Request
            </a>
        </div>
    </div>
}

<!-- Financial Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 stat-card p-3">
            <span class="text-muted small fw-semibold text-uppercase">Total Claimed</span>
            <h3 class="fw-bold text-dark mb-0">₹@Model.TotalClaimedAmount.ToString("N2")</h3>
            <small class="text-muted">Calculated from @Model.Expenses.Count medical expense item(s)</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 stat-card stat-info p-3">
            <span class="text-muted small fw-semibold text-uppercase">Indicative Eligible Amount</span>
            <h3 class="fw-bold text-primary mb-0">
                @(Model.LatestVerificationRun != null ? $"₹{Model.LatestVerificationRun.TotalEligible:N2}" : "Pending Verification")
            </h3>
            <small class="text-muted">Generated by rule-based policy verification</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 stat-card @(Model.Decision != null ? "stat-success" : "") p-3">
            <span class="text-muted small fw-semibold text-uppercase">Final Approved Amount</span>
            <h3 class="fw-bold @(Model.Decision != null ? "text-success" : "text-secondary") mb-0">
                @(Model.Decision != null ? $"₹{Model.Decision.ApprovedAmount:N2}" : "Awaiting Officer Decision")
            </h3>
            <small class="text-muted">
                @(Model.Decision != null ? $"Decided on {Model.Decision.DecisionDate:dd-MMM-yyyy}" : "Subject to Insurance Officer final adjudication")
            </small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Visual Progress Timeline & Status History -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Claim Status Lifecycle</h5>
            </div>
            <div class="card-body p-4">
                <!-- Visual Pipeline Bar -->
                <div class="d-flex justify-content-between text-center mb-4 position-relative">
                    @{
                        int step = Model.ClaimStatus switch
                        {
                            ClaimStatus.Draft => 1,
                            ClaimStatus.Submitted => 2,
                            ClaimStatus.UnderReview => 3,
                            ClaimStatus.InformationRequested => 3,
                            ClaimStatus.Resubmitted => 3,
                            ClaimStatus.Approved => 4,
                            ClaimStatus.PartiallyApproved => 4,
                            ClaimStatus.Rejected => 4,
                            ClaimStatus.Closed => 4,
                            _ => 1
                        };
                    }
                    <div class="flex-fill">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-2 @(step >= 1 ? "bg-primary" : "bg-light text-secondary border")" style="width: 38px; height: 38px;">
                            <i class="bi bi-pencil"></i>
                        </div>
                        <div class="small fw-semibold @(step >= 1 ? "text-primary" : "text-muted")">1. Draft</div>
                    </div>
                    <div class="flex-fill">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-2 @(step >= 2 ? "bg-primary" : "bg-light text-secondary border")" style="width: 38px; height: 38px;">
                            <i class="bi bi-send"></i>
                        </div>
                        <div class="small fw-semibold @(step >= 2 ? "text-primary" : "text-muted")">2. Submitted</div>
                    </div>
                    <div class="flex-fill">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-2 @(step >= 3 ? "bg-warning" : "bg-light text-secondary border")" style="width: 38px; height: 38px;">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div class="small fw-semibold @(step >= 3 ? "text-warning" : "text-muted")">3. Review</div>
                    </div>
                    <div class="flex-fill">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-2 @(step >= 4 ? (Model.ClaimStatus == ClaimStatus.Rejected ? "bg-danger" : "bg-success") : "bg-light text-secondary border")" style="width: 38px; height: 38px;">
                            <i class="bi bi-flag"></i>
                        </div>
                        <div class="small fw-semibold @(step >= 4 ? (Model.ClaimStatus == ClaimStatus.Rejected ? "text-danger" : "text-success") : "text-muted")">4. Decision</div>
                    </div>
                </div>

                <hr />

                <!-- Detailed Audit Timeline -->
                <h6 class="fw-bold text-secondary mb-3">Status Transition Audit Trail:</h6>
                <ul class="timeline mb-0">
                    @foreach (var history in Model.StatusHistories)
                    {
                        <li class="timeline-item">
                            <span class="timeline-badge @(history.NewStatus == ClaimStatus.Approved ? "success" : history.NewStatus == ClaimStatus.Rejected ? "danger" : "active")">
                                <i class="bi bi-check2"></i>
                            </span>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark">@history.NewStatus</strong>
                                    <small class="text-muted">@history.ChangedDate.ToString("dd-MMM-yyyy hh:mm tt")</small>
                                </div>
                                <p class="small text-secondary mb-1">@history.Comment</p>
                                <small class="text-muted"><i class="bi bi-person me-1"></i>Updated by: @history.ChangedByName</small>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Final Decision Details if made -->
        @if (Model.Decision != null)
        {
            <div class="card shadow-sm border-0 border-start border-4 @(Model.Decision.Decision == DecisionType.Approved ? "border-success" : Model.Decision.Decision == DecisionType.Rejected ? "border-danger" : "border-warning") mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2 text-dark">
                        <i class="bi bi-shield-check me-2 text-primary"></i>Official Insurance Officer Decision: @Model.Decision.Decision
                    </h5>
                    <div class="row g-2 mb-3 bg-light p-3 rounded">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Approved Amount:</span>
                            <h4 class="fw-bold text-success mb-0">₹@Model.Decision.ApprovedAmount.ToString("N2")</h4>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Decision Date:</span>
                            <span class="fw-semibold">@Model.Decision.DecisionDate.ToString("dd-MMM-yyyy hh:mm tt")</span>
                        </div>
                    </div>
                    <h6 class="fw-bold text-secondary small mb-1">Officer Justification / Remarks:</h6>
                    <p class="small text-dark bg-white border p-3 rounded mb-0">@Model.Decision.DecisionReason</p>
                </div>
            </div>
        }
    </div>

    <!-- Expenses & Uploaded Documents Overview -->
    <div class="col-lg-5">
        <!-- Expenses Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt me-2 text-primary"></i>Claimed Medical Expenses</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped small align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th>Description</th>
                                <th class="text-end">Claimed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in Model.Expenses)
                            {
                                <tr>
                                    <td class="fw-semibold">@exp.ExpenseCategory</td>
                                    <td class="text-muted">@exp.ExpenseDescription</td>
                                    <td class="text-end fw-bold">₹@exp.ClaimedAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="2">Total Claimed:</th>
                                <th class="text-end fw-bold text-primary">₹@Model.TotalClaimedAmount.ToString("N2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Uploaded Documents Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-paperclip me-2 text-primary"></i>Supporting Documents</h6>
                @if (Model.ClaimStatus == ClaimStatus.InformationRequested)
                {
                    <a asp-action="RespondRequest" asp-route-id="@Model.ClaimId" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-upload me-1"></i> Add Document
                    </a>
                }
            </div>
            <div class="card-body p-3">
                @if (Model.Documents.Any())
                {
                    <div class="list-group list-group-flush small">
                        @foreach (var doc in Model.Documents)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <div>
                                    <i class="bi bi-file-earmark-pdf text-danger fs-5 me-2"></i>
                                    <strong>@doc.OriginalFileName</strong>
                                    <span class="badge bg-light text-dark border ms-1">@doc.DocumentType</span>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        Uploaded: @doc.UploadedDate.ToString("dd-MMM-yyyy") | @(doc.FileSize / 1024) KB
                                    </div>
                                </div>
                                <a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.DocumentId" class="btn btn-sm btn-outline-primary" target="_blank">
                                    <i class="bi bi-download"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center mb-0">No documents attached.</p>
                }
            </div>
        </div>
    </div>
</div>
