@using HealthInsuranceClaims.Application.ViewModels.Dashboard
@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "_Layout";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-workspace text-primary me-2"></i>Welcome, @Model.CustomerName
        </h3>
        <p class="text-muted mb-0">Policyholder Claims Management & Real-time Verification Tracking</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Claims" asp-action="Create" class="btn btn-primary fw-semibold px-3 py-2 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Submit New Claim
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Key Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Active Policies</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.ActivePoliciesCount</h3>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
            </div>
            <a asp-action="Policies" class="stretched-link text-decoration-none small text-primary mt-2 d-inline-block">View details &rarr;</a>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card stat-warning p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Under Review</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.UnderReviewClaims</h3>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
            <a asp-action="Claims" class="stretched-link text-decoration-none small text-warning mt-2 d-inline-block">View tracking &rarr;</a>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card stat-success p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Approved Claims</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.ApprovedClaims</h3>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
            </div>
            <span class="text-muted small mt-2 d-inline-block">₹@Model.TotalApprovedAmount.ToString("N2") Approved</span>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 stat-card stat-info p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Claimed</span>
                    <h4 class="fw-bold mb-0 text-dark">₹@Model.TotalClaimedAmount.ToString("N2")</h4>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
            <span class="text-muted small mt-2 d-inline-block">Across @Model.TotalClaims total claim(s)</span>
        </div>
    </div>
</div>

<!-- Recent Claims Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Claims</h5>
        <a asp-action="Claims" class="btn btn-sm btn-outline-primary">View All Claims</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentClaims.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Claim Ref #</th>
                            <th>Patient Name</th>
                            <th>Policy</th>
                            <th>Claimed Amount</th>
                            <th>Eligible Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.RecentClaims)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@claim.ClaimReferenceNumber</td>
                                <td>@claim.PatientName</td>
                                <td><span class="badge bg-light text-dark border">@claim.PolicyNumber</span></td>
                                <td class="fw-semibold">₹@claim.TotalClaimedAmount.ToString("N2")</td>
                                <td>
                                    @if (claim.IndicativeEligibleAmount.HasValue)
                                    {
                                        <span class="text-success fw-semibold">₹@claim.IndicativeEligibleAmount.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not verified</span>
                                    }
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model="claim.ClaimStatus" />
                                </td>
                                <td class="text-muted small">@claim.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td class="text-end">
                                    @if (claim.ClaimStatus == ClaimStatus.Draft)
                                    {
                                        <a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil-square me-1"></i> Edit Draft
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Track" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-search me-1"></i> Track Progress
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                <h6>No claims submitted yet</h6>
                <p class="small mb-3">You can submit hospital reimbursement claims against your active insurance policy.</p>
                <a asp-controller="Claims" asp-action="Create" class="btn btn-primary btn-sm">Submit First Claim</a>
            </div>
        }
    </div>
</div>
