@using HealthInsuranceClaims.Application.ViewModels.Claims
@model List<ClaimListViewModel>
@{
    ViewData["Title"] = "My Claims";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-card-checklist text-primary me-2"></i>Claim Status & Enquiry</h3>
        <p class="text-muted mb-0">Enquire real-time status and view previous health insurance claims submitted by hospital desks or yourself</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Claim Ref #</th>
                            <th>Patient</th>
                            <th>Policy Number</th>
                            <th>Hospital</th>
                            <th>Total Claimed</th>
                            <th>Indicative Eligible</th>
                            <th>Approved Amount</th>
                            <th>Status</th>
                            <th>Submission Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@claim.ClaimReferenceNumber</td>
                                <td class="fw-semibold">@claim.PatientName</td>
                                <td><span class="badge bg-light text-dark border">@claim.PolicyNumber</span></td>
                                <td class="small text-muted">@claim.HospitalName</td>
                                <td class="fw-semibold">₹@claim.TotalClaimedAmount.ToString("N2")</td>
                                <td>
                                    @if (claim.IndicativeEligibleAmount.HasValue)
                                    {
                                        <span class="text-success fw-semibold">₹@claim.IndicativeEligibleAmount.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (claim.FinalApprovedAmount.HasValue)
                                    {
                                        <span class="badge bg-success-subtle text-success fs-6 fw-bold border border-success-subtle">
                                            ₹@claim.FinalApprovedAmount.Value.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Pending Decision</span>
                                    }
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model="claim.ClaimStatus" />
                                </td>
                                <td class="text-muted small">
                                    @(claim.SubmittedDate.HasValue ? claim.SubmittedDate.Value.ToString("dd-MMM-yyyy") : "Not Submitted")
                                </td>
                                <td class="text-end">
                                    @if (claim.ClaimStatus == ClaimStatus.Draft)
                                    {
                                        <a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i> Edit Draft
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Track" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-search me-1"></i> Track Progress
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                <h5>No Claims Found</h5>
                <p class="small mb-3">You have not submitted any medical reimbursement claims yet.</p>
                <a asp-controller="Claims" asp-action="Create" class="btn btn-primary">Create Your First Claim</a>
            </div>
        }
    </div>
</div>
